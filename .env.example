APP_ENV=development
APP_PORT=8081
DATABASE_URL=postgres://recall:recall@localhost:5436/recall?sslmode=disable
STORAGE_ROOT=./storage

# --- Frame sampler (Phase 1: fixed 2s baseline as explicit plan) ---
# FRAME_SAMPLE_INTERVAL is the baseline grid; SAMPLER_BETA scales the budget
# B = ceil(beta * ceil(duration / interval)). Keep 1.0 to match legacy output.
# FRAME_SAMPLE_INTERVAL=2s
# SAMPLER_BETA=1.0

# --- Adaptive coarse sampler (Phase 2: visual-probe-driven plan) ---
# SAMPLER_ADAPTIVE=false restores the fixed 2-second baseline plan.
# SAMPLER_ADAPTIVE=true
# PROBE_FPS=5
# PROBE_SIZE=64
# PROBE_GRID=8
# PROBE_NOISE_K=3.0
# COARSE_INTERVAL=4s
# COARSE_MAX_GAP=10s
# COARSE_F_KEEP=0.25
# SAMPLER_PLAN_TIMEOUT=5m
# --- Adaptive refinement (Phase 4: best-first midpoint insertion) ---
# priority = max(disagreement, gamma*probe_rank) * gap
# SAMPLER_GAMMA=0.5
# SAMPLER_MIN_GAP=500ms
# SAMPLER_EPSILON=0.1
# SAMPLER_MAX_ROUNDS=4

# --- Detector ---
# DETECTOR_NAME is the single source of truth; MODEL_PATH is auto-derived as workers/detector/{DETECTOR_NAME}.pt
# Only set MODEL_PATH to override with a custom absolute path (e.g., /home/berzz/recall/workers/detector/yolo11n.pt)
DETECTOR_NAME=yolov8n
DETECTOR_VERSION=1
DETECTION_CONFIDENCE_THRESHOLD=0.35
YOLO_BATCH_SIZE=16
PYTHON_PATH=python3
# MODEL_PATH=./workers/detector/yolov8n.pt  # optional override

# --- Tracker ---
TRACKER_TYPE=iou
# TRACKER_HIGH_THRESHOLD=0.6
# TRACKER_LOW_THRESHOLD=0.1
# TRACKER_MATCH_THRESHOLD=0.8
# TRACKER_TRACK_BUFFER=30

# --- Video description (optional) ---
ENABLE_VIDEO_DESCRIPTION=true

# --- Vision: common settings ---
VISION_MAX_FRAMES=3
VISION_MAX_OUTPUT_TOKENS=256
VISION_TIMEOUT=10m
VISION_HISTORY_SEGMENTS=2
VISION_HISTORY_EVENTS=5

# --- Embedding ---
EMBEDDING_PYTHON_PATH=python3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_TIMEOUT=5m

# --- Search (L2.10) ---
SEARCH_CANDIDATE_LIMIT=20
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_MIN_SIMILARITY=0.35

# === Local VLM provider ===
# VISION_PROVIDER=local
# VISION_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
# VISION_MODEL_PATH=/models/SmolVLM2-500M-Video-Instruct
# VISION_MODEL_VERSION=500M-Instruct
# VISION_PYTHON_PATH=python3
# GEMINI_API_KEY=

# === Gemini provider ===
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-2.5-flash-lite
# VISION_MODEL_VERSION=2.5-flash-lite
# GEMINI_API_KEY=your-key-here
# VISION_PYTHON_PATH not needed for Gemini

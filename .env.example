APP_ENV=development
APP_PORT=8081
DATABASE_URL=postgres://recall:recall@localhost:5436/recall?sslmode=disable
STORAGE_ROOT=./storage

# --- Detector ---
# DETECTOR_NAME is the single source of truth; MODEL_PATH is auto-derived as workers/detector/{DETECTOR_NAME}.pt
# Only set MODEL_PATH to override with a custom absolute path (e.g., /home/berzz/recall/workers/detector/yolo11n.pt)
DETECTOR_NAME=yolov8n
DETECTOR_VERSION=1
DETECTION_CONFIDENCE_THRESHOLD=0.35
YOLO_BATCH_SIZE=16
PYTHON_PATH=python3
# MODEL_PATH=./workers/detector/yolov8n.pt  # optional override

# --- Tracker ---
TRACKER_TYPE=iou
# TRACKER_HIGH_THRESHOLD=0.6
# TRACKER_LOW_THRESHOLD=0.1
# TRACKER_MATCH_THRESHOLD=0.8
# TRACKER_TRACK_BUFFER=30

# --- Video description (optional) ---
ENABLE_VIDEO_DESCRIPTION=true

# --- Vision: common settings ---
VISION_MAX_FRAMES=3
VISION_MAX_OUTPUT_TOKENS=256
VISION_TIMEOUT=10m
VISION_HISTORY_SEGMENTS=2
VISION_HISTORY_EVENTS=5

# --- Embedding ---
EMBEDDING_PYTHON_PATH=python3
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_MODEL_VERSION=v1.5
EMBEDDING_TIMEOUT=5m

# --- Search (L2.10) ---
SEARCH_CANDIDATE_LIMIT=20
SEARCH_DEFAULT_LIMIT=10
SEARCH_MAX_LIMIT=50
SEARCH_MIN_SIMILARITY=0.35

# === Local VLM provider ===
# VISION_PROVIDER=local
# VISION_MODEL=HuggingFaceTB/SmolVLM2-500M-Video-Instruct
# VISION_MODEL_PATH=/models/SmolVLM2-500M-Video-Instruct
# VISION_MODEL_VERSION=500M-Instruct
# VISION_PYTHON_PATH=python3
# GEMINI_API_KEY=

# === Gemini provider ===
# VISION_PROVIDER=gemini
# VISION_MODEL=gemini-2.5-flash-lite
# VISION_MODEL_VERSION=2.5-flash-lite
# GEMINI_API_KEY=your-key-here
# VISION_PYTHON_PATH not needed for Gemini

# === TEMPORARY EXPERIMENT: codec-level signal inspection ===
# See services/api/internal/codec_experiment/FINDINGS.md. Default OFF; when off
# the pipeline is byte-for-byte unchanged.
# Requires `pip install -r workers/codec_experiment/requirements.txt` (av, numpy)
# to obtain motion vectors. Without it the experiment falls back to ffprobe and
# reports motion vectors as unavailable.
#CODEC_EXPERIMENT_ENABLED=false
#CODEC_EXPERIMENT_OUT_DIR=./codec_experiment
#CODEC_EXPERIMENT_PYTHON=python3
#CODEC_EXPERIMENT_SCRIPT=workers/codec_experiment/mvdump.py
# 0 = decode the whole file. Set a cap for very long videos; the report then
# marks the statistics as covering a prefix only.
#CODEC_EXPERIMENT_MAX_FRAMES=0
#CODEC_EXPERIMENT_TIMEOUT=10m

# === TEMPORARY EXPERIMENT: dynamic codec-activity sampling ===
# When false, frame extraction is the existing fixed-interval sampler.
# When true, codec activity can add dense 0.2s samples inside merged windows;
# downstream YOLO/tracking/VLM inputs keep the same frame representation.
#CODECSIGHT_DYNAMIC_SAMPLING=false
#CODECSIGHT_DYNAMIC_DENSE_INTERVAL=200ms
#CODECSIGHT_DYNAMIC_WINDOW_BEFORE=1s
#CODECSIGHT_DYNAMIC_WINDOW_AFTER=1s
#CODECSIGHT_DYNAMIC_MERGE_GAP=1s
# Experimental activity weights; they sum to one by convenience, not by proof.
#CODECSIGHT_DYNAMIC_WEIGHT_MEAN=0.40
#CODECSIGHT_DYNAMIC_WEIGHT_MAX=0.20
#CODECSIGHT_DYNAMIC_WEIGHT_STATIC=0.25
#CODECSIGHT_DYNAMIC_WEIGHT_PACKET=0.15
#CODECSIGHT_DYNAMIC_ENTER_THRESHOLD=0.90
#CODECSIGHT_DYNAMIC_EXIT_THRESHOLD=0.70
#CODECSIGHT_DYNAMIC_LOW_PERCENTILE=5
#CODECSIGHT_DYNAMIC_HIGH_PERCENTILE=95
